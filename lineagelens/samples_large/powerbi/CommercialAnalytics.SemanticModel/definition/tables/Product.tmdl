table Product
	lineageTag: 00005eed-0000-0000-0000-00000000004b

	measure 'Active Products' = COUNTROWS(Product)
		formatString: #,0
		lineageTag: 00005eed-0000-0000-0000-00000000004c

	column 'Product Key'
		dataType: int64
		isHidden
		lineageTag: 00005eed-0000-0000-0000-00000000004d
		summarizeBy: none
		sourceColumn: Product Key

	column SKU
		dataType: string
		lineageTag: 00005eed-0000-0000-0000-00000000004e
		summarizeBy: none
		sourceColumn: SKU

	column 'Product Name'
		dataType: string
		lineageTag: 00005eed-0000-0000-0000-00000000004f
		summarizeBy: none
		sourceColumn: Product Name

	column Brand
		dataType: string
		lineageTag: 00005eed-0000-0000-0000-000000000050
		summarizeBy: none
		sourceColumn: Brand

	column 'Product Category'
		dataType: string
		lineageTag: 00005eed-0000-0000-0000-000000000051
		summarizeBy: none
		sourceColumn: Product Category

	column 'Product Subcategory'
		dataType: string
		lineageTag: 00005eed-0000-0000-0000-000000000052
		summarizeBy: none
		sourceColumn: Product Subcategory

	column 'List Price'
		dataType: decimal
		lineageTag: 00005eed-0000-0000-0000-000000000053
		summarizeBy: sum
		sourceColumn: List Price

	column 'Price Band'
		dataType: decimal
		lineageTag: 00005eed-0000-0000-0000-000000000054
		summarizeBy: sum
		sourceColumn: Price Band

	column 'Launch Date'
		dataType: dateTime
		lineageTag: 00005eed-0000-0000-0000-000000000055
		summarizeBy: none
		sourceColumn: Launch Date

	partition Product = m
		mode: import
		source =
				let
				    Source = Snowflake.Databases(SnowflakeAccount, Warehouse, [Implementation="2.0"]),
				    DB = Source{[Name="HELIOS", Kind="Database"]}[Data],
				    Sch = DB{[Name="GOLD", Kind="Schema"]}[Data],
				    Obj = Sch{[Name="DIM_PRODUCT", Kind="Table"]}[Data],
				    #"Selected Columns" = Table.SelectColumns(Obj, {"PRODUCT_KEY", "SKU", "PRODUCT_NAME", "BRAND", "PRODUCT_CATEGORY", "PRODUCT_SUBCATEGORY", "LIST_PRICE", "PRICE_BAND", "LAUNCH_DATE"}),
				    #"Renamed Columns" = Table.RenameColumns(#"Selected Columns", {{"PRODUCT_KEY", "Product Key"}, {"SKU", "SKU"}, {"PRODUCT_NAME", "Product Name"}, {"BRAND", "Brand"}, {"PRODUCT_CATEGORY", "Product Category"}, {"PRODUCT_SUBCATEGORY", "Product Subcategory"}, {"LIST_PRICE", "List Price"}, {"PRICE_BAND", "Price Band"}, {"LAUNCH_DATE", "Launch Date"}})
				in
				    #"Renamed Columns"

	annotation PBI_ResultType = Table
