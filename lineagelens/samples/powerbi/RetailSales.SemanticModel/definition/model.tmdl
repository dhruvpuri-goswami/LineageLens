model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	discourageImplicitMeasures

	annotation PBI_QueryOrder = ["SnowflakeAccount","Warehouse","GoldDatabase","Sales","Customer","Product","Store","Date","Sales Summary"]

ref table Sales
ref table Customer
ref table Product
ref table Store
ref table Date
ref table 'Sales Summary'
ref table 'Time Intelligence'
ref table 'Metric Selector'

ref role 'Regional Manager'
ref role 'EMEA Only'

ref culture en-US
