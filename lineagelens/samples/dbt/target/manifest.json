      "raw_code": "with customers as (\n    select * from {{ ref('stg_customers') }}\n),\ncountries as (\n    select country_code, country_name from {{ ref('country_codes') }}\n)\nselect\n    c.customer_id as customer_key,\n    c.customer_name,\n    c.email as customer_email,\n    c.customer_segment,\n    case\n        when c.customer_segment = 'Enterprise' then 'Tier 1'\n        when c.customer_segment = 'SMB' then 'Tier 2'\n        else 'Tier 3'\n    end as customer_tier,\n    co.country_name,\n    c.created_at as customer_since\nfrom customers c\nleft join countries co on c.country_code = co.country_code\nqualify row_number() over (partition by c.customer_id order by c.created_at desc) = 1\n",
      "compiled_code": "with customers as (\n    select * from analytics.staging.stg_customers\n),\ncountries as (\n    select country_code, country_name from analytics.seeds.country_codes\n)\nselect\n    c.customer_id as customer_key,\n    c.customer_name,\n    c.email as customer_email,\n    c.customer_segment,\n    case\n        when c.customer_segment = 'Enterprise' then 'Tier 1'\n        when c.customer_segment = 'SMB' then 'Tier 2'\n        else 'Tier 3'\n    end as customer_tier,\n    co.country_name,\n    c.created_at as customer_since\nfrom customers c\nleft join countries co on c.country_code = co.country_code\nqualify row_number() over (partition by c.customer_id order by c.created_at desc) = 1\n",
      "compiled": true,
      "relation_name": "ANALYTICS.GOLD.DIM_CUSTOMER",
      "language": "sql"
    },
