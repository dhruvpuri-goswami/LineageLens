      "depends_on": {
        "nodes": [
          "model.retail_analytics.stg_order_items",
          "model.retail_analytics.stg_orders"
        ],
        "macros": []
      },
      "raw_code": "with items as (\n    select * from {{ ref('stg_order_items') }}\n),\norders as (\n    select * from {{ ref('stg_orders') }}\n)\nselect\n    i.order_item_id,\n    i.order_id,\n    o.customer_id,\n    o.store_id,\n    i.product_id,\n    o.order_date,\n    o.order_status,\n    i.quantity,\n    i.unit_price,\n    i.discount_pct,\n    i.net_amount,\n    case\n        when i.discount_pct >= 0.20 then 'High'\n        when i.discount_pct > 0 then 'Low'\n        else 'None'\n    end as discount_band\nfrom items i\ninner join orders o on i.order_id = o.order_id\n",
      "compiled_code": "with items as (\n    select * from analytics.staging.stg_order_items\n),\norders as (\n    select * from analytics.staging.stg_orders\n)\nselect\n    i.order_item_id,\n    i.order_id,\n    o.customer_id,\n    o.store_id,\n    i.product_id,\n    o.order_date,\n    o.order_status,\n    i.quantity,\n    i.unit_price,\n    i.discount_pct,\n    i.net_amount,\n    case\n        when i.discount_pct >= 0.20 then 'High'\n        when i.discount_pct > 0 then 'Low'\n        else 'None'\n    end as discount_band\nfrom items i\ninner join orders o on i.order_id = o.order_id\n",
      "compiled": true,
      "relation_name": "ANALYTICS.INTERMEDIATE.INT_ORDER_LINES",
      "language": "sql"
    },
