# LineageLens settings. Copy to .env (never commit .env) and edit as needed.
# Every line is optional: the defaults below are what you get without a .env file.
# With Docker Compose, the container layout (host 0.0.0.0, port 8765 inside, /data, /inputs)
# is fixed in docker-compose.yml; these values tune everything else.

# --- Network ---
# Address the server binds to (non-Docker runs). Keep 127.0.0.1 so only this computer can reach it.
LINEAGELENS_HOST=127.0.0.1
# Port the server listens on (non-Docker runs).
LINEAGELENS_PORT=8765
# Docker only: port published on 127.0.0.1 of your computer (http://127.0.0.1:<port>).
LINEAGELENS_PUBLISH_PORT=8765
# Host names the server answers to (comma separated). Blocks DNS-rebinding attacks. "*" disables the check.
LINEAGELENS_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]

# --- Data ---
# Folder where the saved lineage graph (SQLite) lives. Empty = %LOCALAPPDATA%\LineageLens or ~/.lineagelens.
# Docker always uses the named volume mounted at /data.
LINEAGELENS_HOME=
# Path to your lineagelens.yml. Docker default: /inputs/lineagelens.yml (= ./inputs/lineagelens.yml on your disk).
# When the file does not exist, the bundled synthetic sample is shown instead.
LINEAGELENS_CONFIG=
# Bundled synthetic sample to show when no config is used: "standard" or "large".
LINEAGELENS_SAMPLE=standard
# Folders that paths typed in the UI (config path, diff inputs) must stay inside. Separate with ";".
# Empty = no restriction (single-user desktop). Docker sets /inputs and /data.
LINEAGELENS_ALLOWED_ROOTS=
# Allow saving config YAML from the Settings page (true/false).
LINEAGELENS_ALLOW_CONFIG_WRITE=true
# Largest accepted request body in MB (1-512). Applies to everything except file uploads.
LINEAGELENS_MAX_BODY_MB=5

# --- Uploads ("Load your data" page) ---
# Allow uploading dbt, Snowflake SQL and Power BI files from the browser (true/false).
# Files are stored under LINEAGELENS_HOME/workspace/<project>/ (Docker: the /data volume) and never leave this computer.
LINEAGELENS_ALLOW_UPLOAD=true
# Largest single upload request in MB (one file, a folder, or a .zip).
LINEAGELENS_MAX_UPLOAD_MB=500
# Zipped PBIP projects: the most they may expand to (MB) and the most entries they may contain.
LINEAGELENS_MAX_UNZIPPED_MB=2000
LINEAGELENS_MAX_ZIP_FILES=20000

# --- Logging ---
# debug, info, warning, error or critical.
LINEAGELENS_LOG_LEVEL=info
# "text" for humans, "json" for one structured JSON object per line (Docker default).
LINEAGELENS_LOG_FORMAT=text

# --- API docs ---
# Serve Swagger UI at /api/docs. Off by default because Swagger UI loads its assets from a CDN.
LINEAGELENS_ENABLE_DOCS=false

# --- Sidebar links (plain links; nothing is loaded from them) ---
# "Sponsor" link. Hidden while it is empty or still contains YOUR_USERNAME.
BUYMEACOFFEE_URL=https://www.buymeacoffee.com/YOUR_USERNAME
# "GitHub" link. Set to empty to hide it.
GITHUB_REPO_URL=https://github.com/dhruvpuri-goswami/LineageLens
